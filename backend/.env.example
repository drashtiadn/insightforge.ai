# Application
APP_NAME=insightforge
APP_VERSION=0.1.0
# development = local / feature branch | production = main
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# CORS (JSON list). Browser clients need explicit origins when credentials=true.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
# CORS_ALLOW_CREDENTIALS=true

# SECRET_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LangSmith (https://smith.langchain.com) — set TRACING=true and API key to enable
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=insightforge
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

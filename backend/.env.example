# Application
APP_NAME=insightforge
APP_VERSION=0.1.0
# development = local / feature branch | production = main
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# CORS (JSON list). Browser clients need explicit origins when credentials=true.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
# CORS_ALLOW_CREDENTIALS=true

# SECRET_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LangSmith (https://smith.langchain.com) — set TRACING=true and API key to enable
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=insightforge
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Search providers (Phase 3.2)
# Tavily preferred for WEB; SearXNG used when Tavily key is unset
# TAVILY_API_KEY=
# SEARXNG_BASE_URL=http://localhost:8080
# GITHUB_TOKEN=
# YOUTUBE_API_KEY=
# REDDIT_USER_AGENT=insightforge/0.1.0 (research platform)
# SEARCH_DEFAULT_LIMIT=5
# SEARCH_TIMEOUT_SECONDS=15
# SEARCH_MAX_WORKERS=4
# SEARCH_RATE_LIMIT_PER_SECOND=2
# SEARCH_DEDUPE_ENABLED=true
# SEARCH_SCORING_ENABLED=true
# SEARCH_MAX_DOCUMENTS=20

# Document processing (Phase 4)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# DOCUMENT_CLEANING_ENABLED=true
# DOCUMENT_CHUNKING_ENABLED=true
# DOCUMENT_CHUNK_STRATEGY=auto
# DOCUMENT_CHUNK_SIZE=1200
# DOCUMENT_CHUNK_OVERLAP=150
# DOCUMENT_SEMANTIC_THRESHOLD=0.25
# DOCUMENT_CITATION_ENABLED=true

# Embeddings (Phase 5.1)
# VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_VOYAGE_MODEL=voyage-3.5
# EMBEDDING_VOYAGE_DIMENSIONS=
# EMBEDDING_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_BATCH_SIZE=32

# Vector stores (Phase 5.2)
# VECTOR_STORE=memory
# VECTOR_DIMENSIONS=1024
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=insightforge
# QDRANT_TIMEOUT_SECONDS=30
# VECTOR_SESSION_TTL_SECONDS=3600

# Retrieval (Phase 5.3)
# RETRIEVAL_MODE=hybrid
# RETRIEVAL_DEFAULT_LIMIT=8
# RETRIEVAL_CANDIDATE_MULTIPLIER=4
# RETRIEVAL_RRF_K=60
# RETRIEVAL_BM25_K1=1.5
# RETRIEVAL_BM25_B=0.75

# Reranking (Phase 5.4)
# JINA_API_KEY=
# RERANKER_PROVIDER=cross-encoder
# RERANKER_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_BGE_MODEL=BAAI/bge-reranker-base
# RERANKER_JINA_MODEL=jina-reranker-v2-base-multilingual
# RERANKER_TIMEOUT_SECONDS=30
# RERANKER_TOP_N=
